# Copy to .env and fill in real values. .env is gitignored — never commit it.

DB_URL=jdbc:postgresql://localhost:5432/eldercare
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Base64, >= 256 bits. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8081

# Seeds the first admin account on startup (needed to verify helpers).
# Remove these once the admin exists.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
