# Copy to .env and fill in real values. .env is gitignored — never commit it.

DB_URL=jdbc:postgresql://localhost:5432/eldercare
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Base64, >= 256 bits. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8081

# Seeds the first admin account on startup (needed to verify helpers).
# Remove these once the admin exists.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Email for confirmation and password-reset codes. Leave MAIL_HOST empty in
# development: emails are then printed in the server log instead of sent.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, your Gmail address, and an
# App Password from myaccount.google.com/apppasswords (not your normal password).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
